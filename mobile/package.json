{
  "name": "tripstory-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "EXPO_NO_CACHE=1 expo start --web",
    "web:export": "EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL:-https://api.mangasmith.com} expo export -p web --output-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "expo": "^52.0.0",
    "expo-asset": "~11.0.5",
    "expo-camera": "~16.0.18",
    "expo-document-picker": "~13.0.3",
    "expo-font": "~13.0.4",
    "expo-video": "~2.0.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.9.2"
  }
}
