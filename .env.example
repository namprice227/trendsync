# Copy this file to .env and fill in only the provider you want to use.
# .env is ignored by git.

# local, openai, gemini, deepseek, or custom
TRIPSTORY_LLM_PROVIDER=local

# OpenAI
OPENAI_API_KEY=
TRIPSTORY_OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
TRIPSTORY_GEMINI_MODEL=gemini-2.0-flash

# DeepSeek
DEEPSEEK_API_KEY=
TRIPSTORY_DEEPSEEK_MODEL=deepseek-chat

# Custom OpenAI-compatible endpoint
TRIPSTORY_LLM_URL=
TRIPSTORY_LLM_MODEL=
TRIPSTORY_LLM_API_KEY=
TRIPSTORY_LLM_TIMEOUT=45
