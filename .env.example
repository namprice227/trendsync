# Copy this file to .env and fill in the providers you want to use.
# .env is ignored by git.

# Text/story generation: local, openai, gemini, deepseek, or custom.
# Recommended split: DeepSeek for text planning, Gemini for video-frame analysis.
TRIPSTORY_LLM_PROVIDER=deepseek

# OpenAI
OPENAI_API_KEY=
TRIPSTORY_OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
TRIPSTORY_GEMINI_MODEL=gemini-2.0-flash
TRIPSTORY_GEMINI_VISION_MODEL=gemini-2.0-flash

# DeepSeek
DEEPSEEK_API_KEY=
TRIPSTORY_DEEPSEEK_MODEL=deepseek-v4-pro
TRIPSTORY_DEEPSEEK_THINKING=enabled
TRIPSTORY_DEEPSEEK_REASONING_EFFORT=high

# Custom OpenAI-compatible endpoint
TRIPSTORY_LLM_URL=
TRIPSTORY_LLM_MODEL=
TRIPSTORY_LLM_API_KEY=
TRIPSTORY_LLM_TIMEOUT=120
TRIPSTORY_LLM_MIN_INTERVAL_SECONDS=3
TRIPSTORY_LLM_MAX_RETRIES=2
TRIPSTORY_STORY_MAX_TOKENS=4096

# Storage, auth, and upload hardening
TRIPSTORY_SESSION_DB=trip_sessions.sqlite3
TRIPSTORY_SQLITE_TIMEOUT_SECONDS=20
TRIPSTORY_MAX_UPLOAD_MB=512
# Leave empty for local development without auth. Set a value to require
# Authorization: Bearer <token> or X-TripStory-Token: <token>.
TRIPSTORY_AUTH_TOKEN=
# Enable these in production after Cloudflare Access is configured for the
# frontend and API hostnames. The API will then require Cloudflare's
# authenticated email header and use it as the project owner id.
TRIPSTORY_REQUIRE_CLOUDFLARE_ACCESS=0
TRIPSTORY_TRUST_CLOUDFLARE_ACCESS_EMAIL=0

# Public deployment URLs. Set these when serving the web app from Cloudflare
# Pages and the API from a public host or Cloudflare Tunnel.
TRIPSTORY_PUBLIC_API_URL=https://api.mangasmith.com
TRIPSTORY_CORS_ORIGINS=https://mangasmith.com,https://www.mangasmith.com

# Queue and worker
TRIPSTORY_QUEUE_BACKEND=rq
TRIPSTORY_REDIS_URL=redis://localhost:6379/0
TRIPSTORY_QUEUE_NAME=tripstory
TRIPSTORY_JOB_TIMEOUT_SECONDS=3600
TRIPSTORY_STALE_JOB_SECONDS=3900

# Media probing subprocess limits. Keep these bounded so a corrupt clip or
# stopped ffmpeg child cannot leave the single local worker occupied forever.
TRIPSTORY_FFMPEG_PROBE_TIMEOUT=30
TRIPSTORY_FFMPEG_AUDIO_TIMEOUT=45
TRIPSTORY_FFMPEG_RENDER_TIMEOUT=300
TRIPSTORY_FFMPEG_AUDIO_MIX_TIMEOUT=300
# Optional if ffmpeg is installed in a conda env but not on PATH.
TRIPSTORY_FFMPEG_BIN=
TRIPSTORY_FFPROBE_BIN=

# Logging and observability
TRIPSTORY_LOG_LEVEL=INFO
TRIPSTORY_LOG_HTTP_REQUESTS=1
# Optional file path. Leave empty to log only to the API/worker terminal.
TRIPSTORY_LOG_FILE=
# Keep off unless debugging locally. When enabled, only short redacted snippets
# are logged; API keys, headers, full prompts, scripts, and uploads are never logged.
TRIPSTORY_LOG_API_PAYLOADS=0

# Narration and audio mixing
# Use gemini with GEMINI_API_KEY, openai with OPENAI_API_KEY, or disabled.
TRIPSTORY_TTS_PROVIDER=gemini
TRIPSTORY_TTS_MODEL=gemini-3.1-flash-tts-preview
TRIPSTORY_TTS_VOICE=Kore
TRIPSTORY_TTS_TIMEOUT=90
TRIPSTORY_TTS_MIN_INTERVAL_SECONDS=3
TRIPSTORY_TTS_MAX_RETRIES=2

# Optional clip speech transcription during upload analysis.
# This sends extracted clip audio to OpenAI, so it is off by default.
TRIPSTORY_ENABLE_TRANSCRIPTION=0
TRIPSTORY_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRIPSTORY_TRANSCRIBE_SECONDS=120

# Optional sampled-frame visual understanding for clip-grounded stories.
# Uses GEMINI_API_KEY by default. One serialized vision request is made per clip.
TRIPSTORY_ENABLE_VISION_ANALYSIS=1
TRIPSTORY_VISION_PROVIDER=gemini
TRIPSTORY_VISION_MODEL=gemini-2.0-flash
TRIPSTORY_VISION_MAX_FRAMES=3
TRIPSTORY_VISION_MIN_INTERVAL_SECONDS=3
TRIPSTORY_VISION_MAX_RETRIES=2
