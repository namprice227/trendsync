[Unit]
Description=TripStory Redis queue
After=network.target

[Service]
Type=simple
User=@TRIPSTORY_USER@
Group=@TRIPSTORY_GROUP@
WorkingDirectory=/var/lib/tripstory
ExecStart=@PROD_ROOT@/env/bin/redis-server --bind 127.0.0.1 --port 6379 --dir /var/lib/tripstory --dbfilename redis.rdb --appendonly yes
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/tripstory /tmp

[Install]
WantedBy=multi-user.target
