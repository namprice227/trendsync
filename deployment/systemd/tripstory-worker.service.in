[Unit]
Description=TripStory background worker
After=network.target tripstory-redis.service
Wants=tripstory-redis.service

[Service]
Type=simple
User=@TRIPSTORY_USER@
Group=@TRIPSTORY_GROUP@
WorkingDirectory=@PROD_ROOT@/app
EnvironmentFile=/etc/tripstory/tripstory.env
ExecStart=@PROD_ROOT@/env/bin/python worker.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/tripstory /var/log/tripstory /tmp

[Install]
WantedBy=multi-user.target
